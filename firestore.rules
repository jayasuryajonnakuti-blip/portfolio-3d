rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidChatSession(data) {
      return data.userId == request.auth.uid
        && data.createdAt is string
        && data.lastMessageAt is string;
    }

    function isValidChatMessage(data, sessionId) {
      return data.sessionId == sessionId
        && data.role in ['user', 'model']
        && data.content is string
        && data.content.size() < 10000
        && data.createdAt is string;
    }

    // --- Rules ---

    match /chatSessions/{sessionId} {
      allow create: if isSignedIn() && isValidId(sessionId) && isValidChatSession(incoming());
      allow read: if isSignedIn() && isOwner(existing().userId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidChatSession(incoming());
      allow delete: if isSignedIn() && isOwner(existing().userId);

      match /messages/{messageId} {
        allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming(), sessionId)
          && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
        allow read: if isSignedIn() 
          && get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }
  }
}
